{{!< default}}

{{!-- The tag above means: insert everything in this file
into the {body} tag of the default.hbs template --}}


{{#post}}
{{!-- Everything inside the #post block pulls data from the page --}}

<main id="site-main" class="site-main">
<article class="article {{post_class}}">

    {{#match @page.show_title_and_feature_image}}
        <header class="article-header gh-canvas">

            <h1 class="article-title">{{title}}</h1>

            {{#if feature_image}}
                <figure class="article-image">
                    {{!-- This is a responsive image, it loads different sizes depending on device
                    https://medium.freecodecamp.org/a-guide-to-responsive-images-with-ready-to-use-templates-c400bd65c433 --}}
                    <img
                        srcset="{{img_url feature_image size="s"}} 300w,
                                {{img_url feature_image size="m"}} 600w,
                                {{img_url feature_image size="l"}} 1000w,
                                {{img_url feature_image size="xl"}} 2000w"
                        sizes="(min-width: 1400px) 1400px, 92vw"
                        src="{{img_url feature_image size="xl"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    />
                    {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
            {{/if}}

        </header>
    {{/match}}

    <section class="gh-content gh-canvas">
        {{content}}

        <div id="api-data-container"><div class="gg-spinner"></div></div>
    </section>

</article>
</main>

{{/post}}

<script id="album-template" type="text/template">
    <% result.forEach(function(album) { 
        const releaseDate = new Date(album.releaseDate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });
        %>
    <div class="gg-upcoming-album-item">
        <div class="gg-upcoming-album-album-cover">
            <a href="<%= `/album/${album.slug}` %>">
            <img src="<%= album.coverUrl %>" alt="<%= album.name %> cover" />
            </a>
        </div>
        <div class="gg-upcoming-album-album-details">
            <h2 class="gg-upcoming-album-album-name">
                <a href="<%= `/album/${album.slug}` %>"><%= album.name %></a>
            </h2>
            <p class="gg-upcoming-album-artist-name"><b><%= album.artist %></b></p>
            <p class="gg-upcoming-album-release-date">Release Date: <%= releaseDate %></p>
        </div>
    </div>
    <% }); %>
</script>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      // Replace with your actual external API endpoint
      const response = await fetch(`${window.__BACKEND_URL__}/public/albums?upcoming=1`);
      if (!response.ok) {
        throw new Error('Network response was not ok');
      }
      const data = await response.json();

      // Get the EJS template
      const templateSource = document.getElementById('album-template').innerHTML;

      // Use EJS to render the template with the data
      const renderedHTML = ejs.render(templateSource, { result: data.result });
      
      // Render the data inside the container
      const container = document.getElementById('api-data-container');
      container.innerHTML = renderedHTML;
      container.classList.add('loaded');
    } catch (error) {
      console.error('Error fetching API data:', error);
      document.getElementById('api-data-container').innerHTML = '<p>Failed to load data.</p>';
    }
  });
</script>